# Copia este archivo como .env.local y completa con los datos de TU proyecto de Supabase
# (Supabase → Project Settings → API). Sin estas dos variables, la plataforma funciona en «modo demostración».
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: limitar el ingreso a correos institucionales (separados por coma), p. ej. ejemplo.cl,mail.ejemplo.cl
DOMINIOS_PERMITIDOS=

# Dirección pública del sitio (para el enlace del correo). En local: http://localhost:3130
NEXT_PUBLIC_SITIO_URL=http://localhost:3130
