{
  "name": "eva-derecho",
  "version": "0.1.0",
  "private": true,
  "description": "EVA — Plataforma académica de IA y Derecho (prototipo para la Escuela de Derecho PUCV)",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --port 3130",
    "build": "next build",
    "start": "next start --port 3130",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:catalogo": "node scripts/catalogo-sql.mjs",
    "check": "node scripts/catalogo-sql.mjs --check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.8",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
